  "description": "Write Assetto Corsa .acreplay files from car positions, with wheels placed from each car's own data.",
  "license": "MIT",
  "author": "Misha Nasledov <misha@nasledov.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishan/assetto-ts.git",
    "directory": "packages/acreplay"
  },
  "homepage": "https://github.com/mishan/assetto-ts/tree/main/packages/acreplay#readme",
  "bugs": "https://github.com/mishan/assetto-ts/issues",
  "keywords": [
    "assetto-corsa",
    "acreplay",
    "replay",
    "sim-racing"
  ],
  "type": "module",
  "exports": {
