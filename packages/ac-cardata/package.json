  "license": "MIT",
  "author": "Misha Nasledov <misha@nasledov.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishan/assetto-ts.git",
    "directory": "packages/ac-cardata"
  },
  "homepage": "https://github.com/mishan/assetto-ts/tree/main/packages/ac-cardata#readme",
  "bugs": "https://github.com/mishan/assetto-ts/issues",
  "keywords": [
    "assetto-corsa",
    "data.acd",
