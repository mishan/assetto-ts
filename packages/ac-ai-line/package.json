  "license": "MIT",
  "author": "Misha Nasledov <misha@nasledov.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishan/assetto-ts.git",
    "directory": "packages/ac-ai-line"
  },
  "homepage": "https://github.com/mishan/assetto-ts/tree/main/packages/ac-ai-line#readme",
  "bugs": "https://github.com/mishan/assetto-ts/issues",
  "keywords": [
    "assetto-corsa",
    "acreplay",
    "replay",
    "sim-racing"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
