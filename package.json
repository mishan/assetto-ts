{
  "name": "assetto-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
