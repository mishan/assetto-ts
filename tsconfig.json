{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "noEmit": true,
    // Typechecked and tested from source, so a clean checkout needs no build
    // first; each package's own build reads the others' built output instead.
    "paths": { "ac-cardata": ["./packages/ac-cardata/src/index.ts"] }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts"]
}
